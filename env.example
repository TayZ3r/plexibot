# Plexify Admin API
ADMIN_API_URL=http://plexify-admin:5000
BOT_API_KEY=change_me_secret_key

# Récap hebdo films & séries (module recap)
# Rédaction par Claude Code avec ton abonnement claude.ai : token généré par `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Optionnel : chemin du binaire si `claude` n'est pas dans le PATH
# CLAUDE_CODE_PATH=
TMDB_API_KEY=
# Optionnel : tendances Trakt (Client ID d'une app sur https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=
# Optionnel : marquage "✅ sur Plex" des titres présents sur le serveur
PLEX_URL=
PLEX_TOKEN=

# Notifications Overseerr / Plexify (module overseerr) : DM au demandeur quand son média est disponible
# Dans Plexify : Paramètres > Notifications > Webhook
#   URL : http://BotCore:3000/overseerr   |   Authorization Header : même valeur que OVERSEERR_WEBHOOK_SECRET
OVERSEERR_WEBHOOK_PORT=3000
OVERSEERR_WEBHOOK_SECRET=
# ID Discord qui reçoit le DM quand on clique sur "Tester" dans Plexify
OVERSEERR_TEST_DISCORD_ID=
